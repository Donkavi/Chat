# ─── Core ────────────────────────────────────────────────────────────────
# MongoDB connection string. For local dev you can run `npm run db:local`
# (starts a disk-backed MongoDB on 27017) and keep this default.
MONGODB_URI=mongodb://127.0.0.1:27017/langa

# Public base URL of the app (used for links in emails and Origin checks).
APP_URL=http://localhost:3000
PORT=3000

# Secret used to HMAC session and password-reset tokens before storing them.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# ─── Image storage ───────────────────────────────────────────────────────
# "local" stores avatars on disk in UPLOAD_DIR and serves them via /api/uploads.
# "cloudinary" uploads to Cloudinary (set the three CLOUDINARY_* values).
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email (password recovery) ───────────────────────────────────────────
# Without SMTP settings, reset links are printed to the server console in
# development only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Langa <no-reply@example.com>"

# ─── Development only ────────────────────────────────────────────────────
# Seeding refuses to run unless the database URI points at localhost,
# or this is set explicitly. Never set this against production.
ALLOW_SEED=false
